generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  level     String   @default("Початковий")
  goal      String   @default("Загальна гнучкість")
  createdAt DateTime @default(now())
  resetToken        String?
resetTokenExpires DateTime?
}
